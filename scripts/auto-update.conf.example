# Config for scripts/auto-update.sh, read every run (roughly every 2 hours,
# via the currency-dashboard-updater systemd timer).
#
# deploy-dashboard.sh copies this file to auto-update.conf (untracked,
# gitignored — your local choice here is never touched by git pulls) the
# first time it runs. Edit auto-update.conf, not this file, to change
# branch. Takes effect on the next scheduled run, or immediately with:
#   sudo systemctl start currency-dashboard-updater

# Branch to track. The updater fetches this branch from "origin" and, if
# it's ahead of the local checkout, fast-resets to it and restarts the
# service. Live data (data.json) and the admin password (config.py) are
# never touched by this — see CLAUDE.md for why.
BRANCH=main

[Unit]
Description=Currency Dashboard auto-updater (git pull + cert renewal)

[Service]
Type=oneshot
ExecStart=/bin/bash /home/kiosk/currency-dashboard/scripts/auto-update.sh
WorkingDirectory=/home/kiosk/currency-dashboard
Environment=INSTALL_DIR=/home/kiosk/currency-dashboard
Environment=SERVICE_NAME=currency-dashboard
User=kiosk
StandardOutput=journal
StandardError=journal
